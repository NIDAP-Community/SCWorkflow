{
  "description": "Mapping of SCWorkflow R function parameters to standardized JSON keys for Galaxy CLI integration",
  "version": "1.0",
  "created": "2025-09-13",
  "functions": {
    "filterSeuratObjectByMetadata": {
      "function_file": "Filter_Seurat_Object_by_Metadata.R",
      "json_template": "filterSeuratObjectByMetadata.json",
      "parameters": {
        "object_input_rds": {
          "r_param": "object",
          "type": "file",
          "description": "Input Seurat object file path",
          "required": true
        },
        "object_output_rds": {
          "r_param": "output",
          "type": "file", 
          "description": "Output Seurat object file path",
          "required": true
        },
        "samples.to.include": {
          "r_param": "samples.to.include",
          "type": "array",
          "description": "Select which samples to include",
          "required": true
        },
        "sample.name": {
          "r_param": "sample.name",
          "type": "string",
          "description": "Sample Name Column",
          "default": "orig.ident",
          "required": true
        },
        "category.to.filter": {
          "r_param": "category.to.filter",
          "type": "string",
          "description": "Metadata column to subset by",
          "required": true
        },
        "values.to.filter": {
          "r_param": "values.to.filter",
          "type": "string_or_array",
          "description": "One or more values to filter",
          "required": true
        },
        "keep.or.remove": {
          "r_param": "keep.or.remove",
          "type": "boolean",
          "description": "TRUE to filter down to selected values, FALSE to filter out",
          "default": true
        },
        "greater.less.than": {
          "r_param": "greater.less.than",
          "type": "string",
          "description": "For numeric filters: greater than or less than",
          "default": "greater than"
        },
        "seed": {
          "r_param": "seed",
          "type": "integer",
          "description": "Random seed for colors",
          "default": 10
        },
        "cut.off": {
          "r_param": "cut.off",
          "type": "number",
          "description": "Cut-off for greater/less than filter",
          "default": 0.5
        },
        "legend.position": {
          "r_param": "legend.position",
          "type": "string",
          "description": "Legend position",
          "default": "top"
        },
        "reduction": {
          "r_param": "reduction",
          "type": "string",
          "description": "Clustering visualization type",
          "default": "umap"
        },
        "plot.as.interactive.plot": {
          "r_param": "plot.as.interactive.plot",
          "type": "boolean",
          "description": "TRUE for interactive, FALSE for static",
          "default": false
        },
        "dot.size": {
          "r_param": "dot.size",
          "type": "number",
          "description": "Size of dots on projection plot",
          "default": 0.1
        },
        "use.cite.seq.data": {
          "r_param": "use.cite.seq.data",
          "type": "boolean",
          "description": "TRUE to plot Antibody clusters from CITEseq",
          "default": false
        }
      }
    },
